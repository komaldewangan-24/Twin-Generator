# ---------------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in real values.
#   cp .env.example .env
# `.env` is gitignored -- NEVER commit real credentials.
# ---------------------------------------------------------------------------

# SQLAlchemy connection string.
# Leave EMPTY to auto-create a local SQLite file at backend/storage/database.db
# (default, zero configuration, fine for development).
# For production use PostgreSQL:
DATABASE_URL=

# Secret used to sign JWT access tokens.
# Generate a long random value, e.g. on Linux/macOS:  openssl rand -hex 32
JWT_SECRET_KEY=

# Optional. Google AI Studio (Gemini) key for AI chat answers.
# Leave EMPTY to fall back to the built-in rule-based assistant,
# which already answers questions from the detection results.
GEMINI_API_KEY=

# Optional. Gemini model used for chat. Google renames models over time, so if chat
# says the AI service is unavailable, check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# Optional. How long to train each 3D model: fast (7000 steps, about 8 min on an Apple M4),
# balanced (12000, 14 min), high (18000, 25 min, the default) or max (30000, 47 min). A slower
# graphics card takes proportionally longer. See README, "Real 3D models".
SPLAT_QUALITY=high
# SPLAT_TRAIN_STEPS=18000   # an exact number of steps instead of a preset

# Optional. Which language model powers the assistant. Leave empty to use the built-in
# rules (works offline). Examples:
#   LLM_PROVIDER=gemini      + LLM_API_KEY=...
#   LLM_PROVIDER=anthropic   + LLM_API_KEY=...         (LLM_MODEL defaults to claude-haiku-5-5)
#   LLM_PROVIDER=ollama      + LLM_MODEL=llama3.2      (free, runs on your computer; install from ollama.com)
# The app never uses ANTHROPIC_API_KEY or similar keys from your shell, only LLM_API_KEY.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Optional. Graphics-memory limits for the 3D trainer. The defaults suit a 6 GB card.
# On a 4 GB laptop GPU (RTX 3050 / 4050) use the lighter values below.
# (The app also retries once with these automatically if the first attempt runs out of memory.)
SPLAT_MAX_SPLATS=1000000
SPLAT_MAX_RESOLUTION=1280
# SPLAT_MAX_SPLATS=300000
# SPLAT_MAX_RESOLUTION=800

# Optional. Extra website addresses allowed to call the API (comma separated). Any
# http://localhost:<port> is already allowed.
CORS_ORIGINS=
