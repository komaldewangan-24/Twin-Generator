# ---------------- Python ----------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------- Node ----------------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ---------------- Secrets & environment ----------------
# Never commit real credentials. Keep the example files only.
.env
.env.*
!.env.example
backend/.env

# ---------------- Runtime data (per-user, regenerated) ----------------
backend/storage/uploads/
backend/storage/splats/
backend/storage/*.db
backend/storage/*.sqlite
backend/storage/*.sqlite3
*.ply
*.splat
# ...except the demo scan that ships with the app
!backend/demo/demo.splat
*.spz
*.mp4
*.mov
*.webm

# ---------------- Model weights (large binaries, rebuild instead) ----------------
backend/models/*.onnx
backend/models/*.pt
backend/models/*.pth
backend/models/*.bin

# ---------------- Logs ----------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------- Local debug scripts ----------------
frontend/verify-splat.mjs

# ---------------- OS / editor ----------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.suo
*.ntvs*

# ---------------- 3D tooling (downloaded binaries) ----------------
backend/tools/
